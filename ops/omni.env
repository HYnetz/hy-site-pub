# Base batch knobs (the loop can auto-tune down if disk is tight)
CITIES_PER_LOCALE=1500
LIMIT_PAGES=80000
WORDS_MIN=260
LOCALES_MAX=6
LANES_MAX=15

# Floor SLOs (simple guards at this stage)
READY_RATE_MIN=0.35        # ≥35% must pass Ready Gate
DISK_MIN_FREE_MB=2048      # pause cull/build if < 2 GB free
